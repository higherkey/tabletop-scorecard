{
  "name": "tabletop-scorecard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "e2e": "node e2e/smoke.mjs",
    "e2e:cloud": "node e2e/cloud.mjs",
    "e2e:worker": "node e2e/worker.mjs",
    "icons": "node scripts/make-icons.mjs",
    "vendor": "node scripts/vendor.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/rls-check.mjs",
    "build:site": "node scripts/build-site.mjs",
    "worker:dev": "npm run build:site && wrangler dev -c wrangler.dev.toml",
    "deploy:worker": "npm run build:site && wrangler deploy"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "lucide-static": "^1.70.0",
    "playwright-core": "^1.49.0",
    "wrangler": "^4.158.0"
  }
}
